# Environment Variables for ScrapSaver

# MongoDB Connection String (e.g. MongoDB Atlas connection URL)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/scrapsaver?retryWrites=true&w=majority

# Secret key for JWT authentication signing
JWT_SECRET=your_super_secret_jwt_key_here

# Port (Optional for local development)
PORT=5000
